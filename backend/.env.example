# PostgreSQL connection string (Neon, Supabase, local, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Port the NestJS server listens on
PORT=3001

# Absolute path to the directory containing CSV data files
CSV_DATA_DIR="/absolute/path/to/data/data-v1"

# US Energy Information Administration API key
# Get one at https://www.eia.gov/opendata/register.php
EIA_API_KEY="your-eia-api-key"

# Secreto para el HMAC del votante en /api/v2/directivos. La IP nunca se guarda:
# se guarda HMAC(ip, VOTE_SALT). Sin esto, votar devuelve 503 — y cambiarlo
# resetea todos los presupuestos de la semana, así que no se rota a la ligera.
VOTE_SALT="una-cadena-larga-y-aleatoria"

# Bucket de assets (Garage / cualquier S3). Guarda los retratos de los
# directivos, que la API sirve por GET /api/v2/directivos/:slug/foto — el bucket
# NO es público. Sin esto, esa ruta devuelve 503 y la lista cae al monograma.
S3_ENDPOINT="https://s3-....sslip.io"
S3_BUCKET="vacamuerta-assets"
S3_ACCESS_KEY_ID="GK..."
S3_SECRET_ACCESS_KEY="..."
S3_REGION="garage"

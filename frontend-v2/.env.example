# Petrodata API (NestJS backend exposing /api/v1/* y /api/v2/*). Sin barra final.
NEXT_PUBLIC_API_BASE_URL=https://api.petrodata.dylansz.com

# Google Analytics 4 (G-XXXXXXX). Se inlinea en el build: en Coolify va como Build Variable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Chat IA (/api/chat). Sólo servidor; sin la key el chat responde 503.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Tope global de consultas al chat por día (protege el gasto si alguien esquiva el cupo por IP).
# CHAT_DAILY_CAP=2000

# Cloudflare Turnstile en el voto de /directivos (opcional; va con TURNSTILE_SECRET en el backend).
# Se inlinea en el build: en Coolify va como Build Variable.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Clave interna hacia la API (sólo servidor, sin NEXT_PUBLIC). La misma que INTERNAL_API_KEY
# del backend: saca a este servidor del límite de 120/min por IP. Runtime y build.
# INTERNAL_API_KEY=

# Petrodata API (NestJS backend exposing /api/v1/* y /api/v2/*). Sin barra final.
NEXT_PUBLIC_API_BASE_URL=https://api.petrodata.dylansz.com

# Vacamuerta IA (/api/chat). Sin la key, el chat responde 503 y el resto del sitio sigue igual.
DEEPSEEK_API_KEY=
# Opcional; por defecto deepseek-chat
DEEPSEEK_MODEL=
